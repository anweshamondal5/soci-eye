# Soci-Eye Backend Environment Variables
# Copy this file to .env and insert your API keys

# Google Cloud Console -> YouTube Data API v3 (Optional for live YouTube scraping)
YOUTUBE_API_KEY=

# Google AI Studio -> Gemini API Key (Optional for live LLM inference)
GEMINI_API_KEY=

# Pipeline Parameters
MAX_VIDEOS=5
MAX_COMMENTS_PER_VIDEO=20
